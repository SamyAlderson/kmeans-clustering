# .gitignore

# ignore generated files
__pycache__/
*.pyc
*.pyo

# ignore IDE and editor files
.idea/
.vscode/
*.suo
*.ntvs*
*.sln.docstates

# ignore build and deployment files
build/
dist/
*.egg-info
coverage.xml
coverage.html
coverage.json

# ignore other stuff
*.log
*.tmp
*.bak
*.swp
*.pyd
*.so
*.dll